# =========================================================================
# AdjointRWM / para_001
# Large artefacts live on Google Drive (see docs/DRIVE_INVENTORY.csv).
# Commit only small, reviewable results: JSON, CSV, JSONL, parquet < ~5 MB,
# PNG/SVG figures.
# =========================================================================

# --- Model weights, tensors and bulky data --------------------------------
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.engine
*.npy
*.npz
*.h5
*.hdf5
*.tfrecord*
*.arrow
*.zip
*.tar
*.tar.gz
*.tgz
checkpoints/
datasets/
data/raw/
data/cache/
tensorflow_datasets/

# --- Training run outputs (copy the small artefacts into results/runs/) ----
runs_local/
wandb/
mlruns/
lightning_logs/
tb_logs/
events.out.tfevents.*
*.prof
*.trace.json
profiler_trace*.json
**/diagnostics/allocation_tensors_*.npz

# --- Colab local cache/work directories -----------------------------------
adjoint_rwm_cache/
adjoint_rwm_work/
sample_data/
drive/

# --- Notebooks ------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb
# Executed copies with outputs stay on Drive; commit stripped notebooks only.
*.executed.ipynb
*.nbconvert.ipynb

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Environments ---------------------------------------------------------
.venv/
venv/
env/
.env
.env.*
!.env.example
.python-version
.conda/

# --- Secrets and credentials (never commit) -------------------------------
*.pem
*.key
credentials*.json
service_account*.json
client_secret*.json
.netrc
.kaggle/
gcloud/

# --- Editors and OS -------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Logs -----------------------------------------------------------------
*.log
nohup.out

# --- Keep committed run artefacts even if a pattern above matches ----------
!results/runs/**/*.json
!results/runs/**/*.jsonl
!results/runs/**/*.csv
!results/runs/**/*.parquet
!results/runs/**/*.png
